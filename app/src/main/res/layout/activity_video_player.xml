<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:forceDarkAllowed="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/video_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.media3.ui.PlayerView
            android:id="@+id/video_exo_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:keepScreenOn="true"
            app:show_buffering="when_playing"
            app:surface_type="texture_view"
            app:use_controller="true" />

        <SurfaceView
            android:id="@+id/video_media_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:keepScreenOn="true"
            android:visibility="gone" />

        <WebView
            android:id="@+id/video_youtube_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"
            android:keepScreenOn="true"
            android:visibility="gone" />

        <View
            android:id="@+id/video_brightness_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <View
            android:id="@+id/video_sharpness_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_video_sharpness_overlay"
            android:importantForAccessibility="no"
            android:visibility="gone" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/video_controls_overlay"
        android:forceDarkAllowed="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:id="@+id/video_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#66000000"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/video_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_button_description"
                android:padding="12dp"
                android:src="@drawable/ic_cancel"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/video_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/video_player_title"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/video_open_youtube"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_player_open_youtube"
                android:gravity="center"
                android:minWidth="54dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/video_player_open_youtube_short"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/video_bottom_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_video_bottom_pill"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/video_captions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_player_captions_title"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/video_player_captions_short_on"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/video_enhance"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_player_enhancement_title"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/video_player_enhance_short"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/video_quality"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_player_quality"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/video_player_quality_short"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/video_quality_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="76dp"
            android:background="@drawable/bg_video_options_panel"
            android:elevation="18dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/video_quality_panel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_player_quality_available"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/video_quality_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/video_seek_feedback_left"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="42dp"
        android:alpha="0"
        android:background="@drawable/bg_video_seek_feedback"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/video_seek_feedback_right"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="42dp"
        android:alpha="0"
        android:background="@drawable/bg_video_seek_feedback"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/video_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true" />

</FrameLayout>
