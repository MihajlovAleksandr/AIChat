<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end">
                <TextView
                    android:id="@+id/btnLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:text="@string/language_mark"
                    android:contentDescription="@string/language_mark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#42969E"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#42969E"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sign_in_subtitle"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_marginBottom="36dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/email_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="clear_text"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="emailAddress"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/password_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_gravity="center_horizontal"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:text="@string/login_button"
                android:contentDescription="@string/login_button"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:enabled="false"
                android:textColor="@color/login_button_text"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/login_button_tint"
                app:rippleColor="@color/login_button_ripple" />

            <com.example.aichat.view.NeonTextView
                android:id="@+id/qrLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/login_by_qr"
                android:contentDescription="@string/login_by_qr"
                android:textSize="17sp"
                android:textStyle="bold"
                app:neonBaseColor="#FF42969A"
                app:neonBrightColor="#FF6ED5DE"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>

            <com.example.aichat.view.NeonTextView
                android:id="@+id/registerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="14dp"
                android:text="@string/registration"
                android:contentDescription="@string/registration"
                android:textSize="17sp"
                android:textStyle="bold"
                app:neonBaseColor="#FF42969A"
                app:neonBrightColor="#FF6ED5DE"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/facebook_login"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_social_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_facebook_foreground"
                    android:contentDescription="@string/facebook_login_desc" />

                <ImageView
                    android:id="@+id/sign_in_button"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/bg_social_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_google_foreground"
                    android:contentDescription="@string/google_login_desc" />

                <ImageView
                    android:id="@+id/instagram_login"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_social_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerInside"
                    android:src="@mipmap/ic_instagram_foreground"
                    android:contentDescription="@string/instagram_login_desc" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/loginErrorTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:background="@drawable/login_error_background"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="160dp" />

</androidx.constraintlayout.widget.ConstraintLayout>