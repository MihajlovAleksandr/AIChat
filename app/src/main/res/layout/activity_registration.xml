<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    android:importantForAutofill="noExcludeDescendants">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="480dp"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingHorizontal="28dp"
            android:paddingTop="40dp"
            android:paddingBottom="60dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end">

                <TextView
                    android:id="@+id/btnLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:text="@string/language_mark"
                    android:contentDescription="@string/change_language_desc"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#42969E"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/registration_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#42969E"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registration_subtitle"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_marginBottom="36dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/email_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="clear_text"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="emailAddress"
                    android:focusable="true"
                    android:focusableInTouchMode="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/password_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"
                    android:focusable="true"
                    android:focusableInTouchMode="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirmPasswordInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/confirm_password_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/confirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"
                    android:focusable="true"
                    android:focusableInTouchMode="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registration"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_gravity="center_horizontal"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:textColor="@color/login_button_text"
                android:text="@string/register_button"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:enabled="false"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/login_button_tint"
                app:rippleColor="@color/login_button_ripple" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/alreadyAccountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/already_account_prefix"
                    android:textSize="17sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:paddingHorizontal="4dp" />

                <com.example.aichat.view.NeonTextView
                    android:id="@+id/loginTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="2dp"
                    android:text="@string/login_link_text"
                    android:textSize="17sp"
                    android:textStyle="bold|italic"
                    app:neonBaseColor="#FF42969A"
                    app:neonBrightColor="#FF6ED5DE" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/progressDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_gravity="bottom">

        <View
            android:id="@+id/dot1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_active"
            android:layout_margin="4dp"/>
        <View
            android:id="@+id/dot2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_default"
            android:layout_margin="4dp"/>
        <View
            android:id="@+id/dot3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_default"
            android:layout_margin="4dp"/>
        <View
            android:id="@+id/dot4"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_default"
            android:layout_margin="4dp"/>
    </LinearLayout>

</FrameLayout>