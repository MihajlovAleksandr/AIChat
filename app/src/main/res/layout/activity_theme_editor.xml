<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <ImageView
        android:id="@+id/theme_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:background="@android:color/transparent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"/>

    <View
        android:id="@+id/theme_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000"
        android:importantForAccessibility="no"
        android:visibility="gone"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/editor_content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="12dp"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/top_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp">

                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/back"
                        android:padding="12dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="?attr/colorOnSurface"/>

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/theme_editor_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/btn_save"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="2dp"
                        android:text="@string/theme_editor_save"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_theme_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="20dp"
                    android:hint="@string/theme_editor_name_hint"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:endIconMode="clear_text"
                    app:hintTextColor="?attr/colorOnSurfaceVariant">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_theme_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:text="@string/theme_editor_default_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/theme_editor_colors_section"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/row_primary"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <View
                        android:id="@+id/dot_primary"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_theme_circle"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_editor_primary_color"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_primary_hex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="#20A39A"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_text"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <View
                        android:id="@+id/dot_text"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_theme_circle"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_editor_text_color"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_text_hex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="#1A1A1A"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_text_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <View
                        android:id="@+id/dot_text_secondary"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_theme_circle"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_editor_secondary_text_color"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_text_secondary_hex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="#666666"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_my_message"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <View
                        android:id="@+id/dot_my_message"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_theme_circle"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_editor_my_messages_color"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_my_message_hex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="#20A39A"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_other_message"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <View
                        android:id="@+id/dot_other_message"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_theme_circle"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_editor_other_messages_color"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_other_message_hex"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="#F1F1F1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/theme_editor_chat_background_section"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <LinearLayout
                    android:id="@+id/row_chat_background"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="@string/theme_editor_icon_background"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_editor_background_image"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_chat_background_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="#FFFFFF"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_message_animation"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:gravity="center"
                        android:text="@string/theme_editor_icon_animation"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="25sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/theme_editor_message_animation"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_message_animation_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/theme_editor_default_value"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="28sp"/>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="@string/theme_editor_open_full_preview"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:id="@+id/preview_content_root"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:minHeight="150dp">

                        <ImageView
                            android:id="@+id/preview_background_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/theme_editor_background_image"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>

                        <View
                            android:id="@+id/preview_image_scrim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#33000000"
                            android:visibility="gone"/>

                        <LinearLayout
                            android:id="@+id/preview_messages_root"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:minHeight="150dp"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/preview_other_avatar"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_theme_circle"/>

                                <TextView
                                    android:id="@+id/preview_other_message"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/bg_preview_bubble_other"
                                    android:paddingStart="14dp"
                                    android:paddingTop="10dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="10dp"
                                    android:text="@string/theme_editor_preview_other_message"
                                    android:textColor="#1A1A1A"
                                    android:textSize="14sp"/>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/preview_time_other"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="44dp"
                                android:layout_marginTop="5dp"
                                android:text="@string/theme_editor_preview_time"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp"/>

                            <TextView
                                android:id="@+id/preview_my_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_preview_bubble_my"
                                android:paddingStart="14dp"
                                android:paddingTop="10dp"
                                android:paddingEnd="14dp"
                                android:paddingBottom="10dp"
                                android:text="@string/theme_editor_preview_my_message"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/preview_time_my"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:layout_marginTop="5dp"
                                android:text="@string/theme_editor_preview_time_read"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp"/>

                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>