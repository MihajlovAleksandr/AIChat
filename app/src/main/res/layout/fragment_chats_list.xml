<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <include
        android:id="@+id/main_toolbar"
        layout="@layout/view_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        app:layout_constraintTop_toBottomOf="@id/main_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <include
        android:id="@+id/overlay_search_bar"
        layout="@layout/view_search_bar"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/main_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:clipToOutline="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:background="@drawable/bg_bottom_panel_blur"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_settings_bottom_1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/settings"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_settings_bottom_2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/settings"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_settings_bottom_3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/settings"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_settings_bottom_4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/settings"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_chat"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="124dp"
        android:src="@drawable/ic_chat"
        android:backgroundTint="@color/teal_primary"
        app:tint="@color/buttonTextLight"
        app:fabSize="mini"
        app:rippleColor="@color/rippleLight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_test_create_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Тест CreateChat"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/fab_add_chat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
