<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <include
        android:id="@+id/main_toolbar"
        layout="@layout/view_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="0dp"
        android:scrollbarThumbVertical="@android:color/darker_gray"
        android:scrollbarSize="4dp"
        app:layout_constraintTop_toBottomOf="@id/main_toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/empty_chats_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/main_toolbar"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.example.aichat.view.NeonTextView
            android:id="@+id/tv_empty_chats_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_chats_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:translationY="-5dp"
            android:clickable="false"
            android:focusable="false"
            android:foreground="@null"
            app:neonBaseColor="#FF42969A"
            app:neonBrightColor="#FF6ED5DE"/>

        <TextView
            android:id="@+id/tv_empty_chats_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_chats_subtitle"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <include
        android:id="@+id/overlay_search_bar"
        layout="@layout/view_search_bar"
        android:visibility="visible"
        android:clickable="false"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:enabled="false"
        android:importantForAccessibility="noHideDescendants"
        android:elevation="0dp"
        android:translationZ="-1dp"
        app:layout_constraintTop_toTopOf="@id/main_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_panel_blur"
        android:clipToOutline="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="4">

            <!-- THEMES -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_themes"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_theme_editor"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/themes"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:text="@string/themes"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

            <!-- MARKETPLACE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_marketplace"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_marketplace"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/marketplace"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:text="@string/marketplace"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

            <!-- SETTINGS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/settings"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:text="@string/settings"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

            <!-- SUBSCRIBE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_subscribe"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:background="@drawable/ripple_toolbar_icon"
                    android:src="@drawable/ic_subscribe"
                    app:tint="?attr/colorOnSurface"
                    android:contentDescription="@string/subscribe"/>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:text="@string/subscribe"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurface"
                    style="@style/TextAppearance.Material3.BodySmall"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_chat"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="92dp"
        android:src="@drawable/ic_chat"
        android:backgroundTint="@color/teal_primary"
        app:tint="@color/buttonTextLight"
        app:fabSize="mini"
        app:rippleColor="@color/rippleLight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_test_create_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Тест CreateChat"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/fab_add_chat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>