<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_circle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/video_circle_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
         />

    <TextView
        android:id="@+id/tv_video_circle_timer"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="#80000000"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="0:00"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/video_circle_controls"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <ImageButton
            android:id="@+id/btn_video_circle_cancel"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_status_circle"
            android:padding="14dp"
            android:src="@drawable/ic_delete"
            android:tint="@android:color/white" />

        <Space
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_video_circle_record"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_status_circle"
            android:padding="14dp"
            android:src="@drawable/ic_fiber_manual_record"
            android:tint="#F44336" />

        <Space
            android:layout_width="32dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_video_circle_send"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_status_circle"
            android:padding="14dp"
            android:src="@drawable/ic_send"
            android:tint="@android:color/white" />

    </LinearLayout>

</FrameLayout>