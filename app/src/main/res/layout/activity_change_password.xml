<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="80dp"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:maxWidth="480dp">

            <TextView
                android:id="@+id/changePasswordTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_password_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#42969E"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/changePasswordSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_password_subtitle"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_marginBottom="36dp"/>

            <!-- Текущий пароль -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/currentPasswordInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/password_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/currentPasswordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"/>
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/newPasswordInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/new_password_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/newPasswordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"/>
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/confirmPasswordInputLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:minHeight="72dp"
                android:hint="@string/confirm_password_hint"
                app:errorEnabled="true"
                app:helperTextEnabled="true"
                app:helperText=" "
                app:boxBackgroundMode="outline"
                app:boxBackgroundColor="@android:color/transparent"
                app:boxStrokeColor="@color/textinput_stroke_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/textinput_hint_light_selector"
                app:endIconTint="@color/textinput_endicon_light_selector">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/confirmPasswordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword|textNoSuggestions"
                    android:backgroundTint="@null"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changePasswordButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="280dp"
                android:maxWidth="480dp"
                android:text="@string/change_password"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/login_button_text"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/login_button_tint"
                app:rippleColor="@color/login_button_ripple"
                android:layout_marginTop="28dp"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnBack"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ic_reply"
        android:contentDescription="@string/back_button_desc"
        app:backgroundTint="@color/teal_primary"
        app:tint="@color/buttonTextLight"
        app:rippleColor="@color/rippleLight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="55dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>