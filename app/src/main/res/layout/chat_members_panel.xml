<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/membersPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:elevation="16dp"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/membersHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorPrimary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btn_back_members"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_close_circle_themed"
            android:contentDescription="@string/close_button_description"
            android:padding="13dp"
            android:src="@drawable/ic_cancel"
            app:tint="?attr/colorOnPrimary"/>

        <TextView
            android:id="@+id/membersTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/chat_members_title"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btn_members_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/options_button_description"
            android:padding="12dp"
            android:src="@drawable/ic_menu_more"
            android:visibility="gone"
            app:tint="?attr/colorOnPrimary"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/membersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:clipToPadding="false"
        android:focusable="true"
        android:maxHeight="300dp"
        android:overScrollMode="never"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.32"
        android:background="?attr/colorOnSurface"/>

</LinearLayout>