<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_circle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/video_circle_drafts_panel"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="114dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/tv_video_circle_draft_counter"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chat_action_panel"
            android:gravity="center"
            android:text="0/5"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/video_circle_drafts"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/video_circle_center_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="74dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_video_circle_timer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_chat_action_panel"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="0:00"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/video_circle_preview_card"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_marginTop="14dp"
            android:clipChildren="true"
            android:clipToOutline="true"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="160dp"
            app:cardElevation="10dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <com.example.aichat.view.main.chat.helpers.CircleClipFrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/video_circle_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/colorSurfaceVariant"
                    app:implementationMode="compatible"
                    app:scaleType="fillCenter" />

                <com.example.aichat.view.main.chat.helpers.CircleVideoTextureView
                    android:id="@+id/video_circle_playback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_video_circle_draft_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_chat_action_panel"
                    android:gravity="center"
                    android:minWidth="86dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="черновик"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </com.example.aichat.view.main.chat.helpers.CircleClipFrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_video_circle_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:maxLines="4"
            android:text="Нажмите красную кнопку для записи кружка"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/video_circle_controls"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/btn_video_circle_cancel"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_status_circle"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:contentDescription="Отменить"
            android:padding="13dp"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorOnSurface" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_video_circle_switch_camera"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_status_circle"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:contentDescription="Сменить камеру"
            android:padding="13dp"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="?attr/colorOnSurface" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_video_circle_record"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_status_circle"
            android:backgroundTint="?attr/colorSurface"
            android:contentDescription="Запись / пауза / продолжить"
            android:padding="15dp"
            android:src="@drawable/ic_fiber_manual_record"
            app:tint="#F44336" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_video_circle_stop"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_status_circle"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:contentDescription="Остановить запись"
            android:padding="13dp"
            android:src="@drawable/ic_stop"
            app:tint="?attr/colorOnSurface" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <ImageButton
            android:id="@+id/btn_video_circle_send"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_status_circle"
            android:backgroundTint="?attr/colorPrimary"
            android:contentDescription="Отправить"
            android:padding="13dp"
            android:src="@drawable/ic_send_telegram"
            app:tint="?attr/colorOnPrimary" />

    </LinearLayout>

</FrameLayout>
